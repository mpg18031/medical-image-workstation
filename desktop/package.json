{
  "name": "mivw-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MIVW cross-platform desktop client (Electron + Vue 3 + Quasar)",
  "homepage": "https://github.com/mivw/mivw",
  "author": {
    "name": "MIVW Contributors",
    "email": "oss@mivw.invalid"
  },
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "quasar dev -m electron",
    "build": "quasar build -m electron",
    "lint": "eslint . --max-warnings 0 && vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --test",
    "test:component": "test-storybook --url http://127.0.0.1:6006 --maxWorkers=2",
    "test:e2e": "playwright test",
    "generate:client": "openapi-typescript ../openapi.json -o src/services/generated/schema.d.ts"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@quasar/vite-plugin": "^2.0.2",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/test-runner": "^0.26.0",
    "@storybook/vue3-vite": "^10.6.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.107.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
