{
  "name": "mivw-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MIVW cross-platform desktop client (Electron + Vue 3 + Quasar)",
  "homepage": "https://github.com/mivw/mivw",
  "author": {
    "name": "MIVW Contributors",
    "email": "oss@mivw.invalid"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "quasar dev -m electron",
    "build": "quasar build -m electron",
    "lint": "eslint . --max-warnings 0 && vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --test",
    "test:component": "test-storybook --url http://127.0.0.1:6006 --maxWorkers=2",
    "test:e2e": "playwright test",
    "generate:client": "openapi-typescript ../openapi.json -o src/services/generated/schema.d.ts"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.12",
    "pinia": "^2.2.4",
    "quasar": "^2.17.0",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@playwright/test": "^1.48.0",
    "@quasar/app-vite": "^2.0.0",
    "@quasar/vite-plugin": "^1.8.0",
    "@storybook/addon-a11y": "^8.3.5",
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/addon-interactions": "^8.3.5",
    "@storybook/test": "^8.3.5",
    "@storybook/test-runner": "^0.22.1",
    "@storybook/vue3-vite": "^8.3.5",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^2.1.2",
    "@vue/test-utils": "^2.4.6",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.7",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.1",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.80.0",
    "storybook": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "vue-tsc": "^2.1.6"
  }
}
