# Copy to .env.local and fill in. NEVER commit the filled version.
# Key material must come from a KMS or OS keychain, not from this file.

# local | server
MIVW_MODE=local
MIVW_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# The application connects as mivw_service; each transaction assumes mivw_app
# so tenant RLS remains enforced. Docker exposes PostgreSQL on port 5434.
MIVW_DB_DSN=postgresql://mivw_service:devonly_not_for_deployment@localhost:5434/mivw
MIVW_DB_POOL_MIN=2
MIVW_DB_POOL_MAX=16

# --- Object store -----------------------------------------------------------
MIVW_OBJECT_ENDPOINT=http://localhost:9000
MIVW_OBJECT_BUCKET=mivw-volumes
MIVW_OBJECT_REGION=us-east-1

# --- Identity ---------------------------------------------------------------
# Must match the host the desktop app actually requests tokens from (127.0.0.1),
# since Keycloak sets the JWT `iss` claim from the request host it received and
# the API compares it byte-for-byte.
MIVW_OIDC_ISSUER=http://127.0.0.1:8080/realms/mivw
MIVW_OIDC_AUDIENCE=mivw-workstation
MIVW_OIDC_JWKS_TTL_SECONDS=3600
MIVW_ALLOWED_ORIGIN=http://localhost:9300

# --- Cryptography -----------------------------------------------------------
# Identifiers of keys resolved at runtime from KMS/keychain. Not the keys themselves.
MIVW_ENCRYPTION_KEY_ID=mivw-phi-v1
MIVW_HMAC_KEY_ID=mivw-hmac-v1

# --- GPU / rendering --------------------------------------------------------
MIVW_GPU_DEVICE=0
MIVW_RENDER_SESSION_IDLE_TIMEOUT_S=900
MIVW_RENDER_MAX_SESSIONS_PER_USER=4
MIVW_RENDER_STILL_DELAY_MS=150

# --- Inference --------------------------------------------------------------
MIVW_TRT_ENGINE_CACHE_DIR=.cache/trt
MIVW_TRT_ENGINE_CACHE_MAX_GB=20

# --- Server mode only -------------------------------------------------------
MIVW_TLS_CERT_FILE=
MIVW_TLS_KEY_FILE=
MIVW_MTLS_CA_FILE=
MIVW_ALLOWED_ORIGIN=
