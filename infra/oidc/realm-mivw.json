{
  "realm": "mivw",
  "enabled": true,
  "clients": [
    {
      "clientId": "mivw-workstation",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:9300/*"],
      "webOrigins": ["http://localhost:9300"],
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "role",
            "claim.name": "role",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mivw-workstation",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "researcher",
      "enabled": true,
      "email": "researcher@example.invalid",
      "firstName": "Dev",
      "lastName": "Researcher",
      "attributes": {
        "org_id": ["11111111-1111-1111-1111-111111111111"],
        "role": ["researcher"]
      },
      "credentials": [
        { "type": "password", "value": "devonly_not_for_deployment", "temporary": false }
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.invalid",
      "firstName": "Dev",
      "lastName": "Admin",
      "attributes": {
        "org_id": ["11111111-1111-1111-1111-111111111111"],
        "role": ["admin"]
      },
      "credentials": [
        { "type": "password", "value": "devonly_not_for_deployment", "temporary": false }
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@example.invalid",
      "firstName": "Dev",
      "lastName": "Viewer",
      "attributes": {
        "org_id": ["11111111-1111-1111-1111-111111111111"],
        "role": ["viewer"]
      },
      "credentials": [
        { "type": "password", "value": "devonly_not_for_deployment", "temporary": false }
      ]
    },
    {
      "username": "other-tenant",
      "enabled": true,
      "email": "other@example.invalid",
      "firstName": "Other",
      "lastName": "Tenant User",
      "attributes": {
        "org_id": ["22222222-2222-2222-2222-222222222222"],
        "role": ["researcher"]
      },
      "credentials": [
        { "type": "password", "value": "devonly_not_for_deployment", "temporary": false }
      ]
    }
  ]
}
